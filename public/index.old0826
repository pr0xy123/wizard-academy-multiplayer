<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lore & Legends Academy - Mystic Dungeons</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.4/socket.io.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@400;700&display=swap');
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body { 
            margin: 0; 
            overflow: hidden; 
            background: #000; 
            font-family: 'Lato', sans-serif;
            color: #f4e4c1;
        }
        
        h1, h2, h3, .fantasy-font { font-family: 'Cinzel', serif; }
        
        #game-container { position: relative; width: 100vw; height: 100vh; }
        #render-canvas { display: block; width: 100%; height: 100%; }
        
        .crt::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
            background-size: 100% 4px;
            z-index: 50;
            pointer-events: none;
        }
        
        .vignette {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle, transparent 80%, rgba(0,0,0,0.15) 100%);
            pointer-events: none;
            z-index: 5;
        }
        
        #debug-banner {
            position: fixed !important;
            top: 10px !important;
            left: 10px !important;
            background: rgba(255, 255, 0, 0.95) !important;
            color: #000 !important;
            font-weight: bold !important;
            padding: 12px 15px !important;
            border-radius: 6px !important;
            z-index: 9999 !important;
            font-size: 13px !important;
            font-family: monospace !important;
            border: 3px solid #000 !important;
        }
        
        #debug-log {
            position: fixed !important;
            bottom: 10px !important;
            right: 10px !important;
            background: rgba(0, 0, 0, 0.95) !important;
            color: #00ff00 !important;
            font-family: monospace !important;
            font-size: 10px !important;
            padding: 8px !important;
            border-radius: 6px !important;
            z-index: 9999 !important;
            max-width: 350px !important;
            max-height: 250px !important;
            overflow-y: auto !important;
            border: 2px solid #00ff00 !important;
        }
        
        #ui-layer {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 10;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
        }

        .hud-panel {
            background: linear-gradient(135deg, rgba(20, 10, 5, 0.95), rgba(40, 20, 10, 0.9));
            border: 2px solid #8b6914;
            border-radius: 12px;
            padding: 15px;
            color: #f4e4c1;
            text-shadow: 1px 1px 2px #000;
            pointer-events: auto;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }
        
        .stat-bar {
            width: 200px;
            height: 22px;
            background: #2a1810;
            border: 2px solid #5c4033;
            border-radius: 11px;
            overflow: hidden;
            margin-top: 5px;
            position: relative;
        }
        
        .stat-fill { 
            height: 100%; 
            transition: width 0.3s ease;
        }
        
        .health-fill { background: linear-gradient(90deg, #8b0000, #dc143c); }
        .mana-fill { background: linear-gradient(90deg, #0066cc, #00ccff); }
        .xp-fill { background: linear-gradient(90deg, #4a0080, #9370db); }
        
        .spell-book {
            position: absolute;
            bottom: 100px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            background: rgba(0,0,0,0.8);
            padding: 15px;
            border-radius: 20px;
            border: 2px solid #8b6914;
        }
        
        .spell-slot {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #3a2510, #1a1008);
            border: 3px solid #5c4033;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 24px;
        }
        
        .spell-slot:hover {
            transform: translateY(-5px) scale(1.1);
            border-color: #ffd700;
        }
        
        .spell-slot.active {
            border-color: #00ff00;
            background: linear-gradient(135deg, #1a3a1a, #0a200a);
        }
        
        .spell-slot.locked {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .spell-key {
            position: absolute;
            bottom: 2px;
            font-size: 10px;
            color: #888;
        }
        
        .modal {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            background: linear-gradient(135deg, rgba(10, 5, 2, 0.98), rgba(30, 15, 8, 0.95));
            border: 3px solid;
            border-radius: 20px;
            padding: 30px;
            max-width: 600px;
            width: 90%;
            text-align: center;
            display: none;
            z-index: 100;
        }
        
        #combat-modal { border-color: #ff4444; }
        #potion-modal { border-color: #00ccff; }
        #tutor-modal { border-color: #9370db; }
        #chest-modal { border-color: #ffaa00; }
        #skill-tree-modal { border-color: #00ff00; max-width: 800px; }
        #multiplayer-modal { border-color: #00ffff; }
        
        .potion-brewing {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin: 20px 0;
        }
        
        .ingredient {
            background: rgba(60, 40, 20, 0.8);
            border: 2px solid #8b6914;
            border-radius: 10px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .ingredient:hover {
            background: rgba(100, 70, 40, 0.9);
            transform: scale(1.05);
        }
        
        .ingredient.selected {
            border-color: #00ff00;
            background: rgba(0, 100, 0, 0.3);
        }
        
        .cauldron {
            width: 150px;
            height: 150px;
            margin: 20px auto;
            background: radial-gradient(circle, #2a1810 30%, #1a0f08 70%);
            border: 4px solid #5c4033;
            border-radius: 50%;
            position: relative;
        }
        
        .cauldron-liquid {
            position: absolute;
            bottom: 10%;
            left: 10%;
            right: 10%;
            height: 60%;
            background: linear-gradient(180deg, #4a0080, #2a0040);
            border-radius: 50%;
            animation: bubble 2s ease-in-out infinite;
        }
        
        @keyframes bubble {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        
        .grade-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: linear-gradient(135deg, #ffd700, #ffaa00);
            color: #000;
            border-radius: 20px;
            font-weight: bold;
            font-size: 14px;
            margin-top: 10px;
        }
        
        .skill-tree {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin: 20px 0;
        }
        
        .skill-node {
            background: rgba(40, 30, 20, 0.9);
            border: 3px solid #5c4033;
            border-radius: 15px;
            padding: 20px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .skill-node:hover:not(.maxed) {
            border-color: #ffd700;
            transform: scale(1.05);
        }
        
        .skill-node.purchased {
            border-color: #00ff00;
            background: rgba(0, 50, 0, 0.3);
        }
        
        .player-list {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(0,0,0,0.8);
            border: 2px solid #00ffff;
            border-radius: 10px;
            padding: 10px;
            max-width: 200px;
        }
        
        .player-entry {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 5px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        
        .floating-text {
            position: absolute;
            font-weight: bold;
            font-size: 24px;
            text-shadow: 2px 2px 4px #000;
            pointer-events: none;
            animation: floatUp 1.5s ease-out forwards;
            z-index: 200;
        }
        
        @keyframes floatUp {
            0% { transform: translateY(0) scale(1); opacity: 1; }
            100% { transform: translateY(-100px) scale(1.5); opacity: 0; }
        }
        
        #start-screen {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, #0a0502 0%, #1a1008 50%, #0a0502 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 200;
        }
        
        .title {
            font-size: 64px;
            background: linear-gradient(135deg, #ffd700, #ffaa00, #ffd700);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 60px rgba(255, 215, 0, 0.5);
            margin-bottom: 10px;
            letter-spacing: 4px;
        }
        
        .class-selection {
            display: flex;
            gap: 30px;
            margin: 30px 0;
        }
        
        .class-card {
            background: linear-gradient(135deg, rgba(60,40,20,0.9), rgba(30,20,10,0.9));
            border: 3px solid #5c4033;
            border-radius: 20px;
            padding: 30px;
            width: 200px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
        }
        
        .class-card:hover, .class-card.selected {
            border-color: #ffd700;
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(255, 215, 0, 0.3);
        }
        
        .class-icon { font-size: 48px; margin-bottom: 10px; }
        
        .player-nametag {
            position: absolute;
            background: rgba(0,0,0,0.7);
            color: #fff;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 12px;
            pointer-events: none;
            z-index: 100;
            transform: translate(-50%, -100%);
        }
        
        @media (max-width: 768px) {
            .title { font-size: 36px; }
            .class-selection { flex-direction: column; }
            .spell-book { transform: translateX(-50%) scale(0.8); bottom: 80px; }
        }
        
        .btn-fantasy {
            background: linear-gradient(135deg, #8b6914, #4a3728);
            border: 2px solid #ffd700;
            color: #ffd700;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Cinzel', serif;
            margin: 5px;
        }
        .btn-fantasy:hover { transform: scale(1.05); }
    </style>
    <script>
        document.addEventListener('click', function resumeAudioContext() {
            if (typeof Tone !== 'undefined' && Tone.context && Tone.context.state === 'suspended') {
                Tone.context.resume().catch(err => console.log('Audio context already resumed or unavailable:', err));
            }
            document.removeEventListener('click', resumeAudioContext);
        }, { once: true });
    </script>
</head>
<body>
    <div id="game-container" class="crt">
        <div id="debug-banner">🎮 LOADING...</div>
        <div id="debug-log"></div>
        <canvas id="render-canvas"></canvas>
        <div class="vignette"></div>
        <div id="particle-overlay"></div>
        
        <div id="start-screen">
            <h1 class="title">⚔️ Lore & Legends ⚔️</h1>
            <p style="font-size: 20px; color: #c0c0c0; margin-bottom: 10px;">Academy of Mystic Knowledge</p>
            <p style="font-size: 14px; color: #666; margin-bottom: 30px;">Where Learning Becomes Legend</p>
            
            <div style="margin-bottom: 20px;">
                <input type="text" id="player-name" placeholder="Enter Your Name" maxlength="15" 
                       style="padding: 12px 20px; font-size: 18px; border-radius: 25px; border: 2px solid #8b6914; 
                              background: rgba(0,0,0,0.5); color: #f4e4c1; text-align: center; width: 250px;">
            </div>
            
            <h3 style="color: #ffd700; margin-bottom: 15px;">Choose Your Class</h3>
            <div class="class-selection">
                <div class="class-card" onclick="selectClass('barbarian')" id="class-barbarian">
                    <div class="class-icon">⚔️</div>
                    <h3>Barbarian</h3>
                    <p style="font-size: 12px; color: #888;">High HP • Melee Combat</p>
                </div>
                <div class="class-card" onclick="selectClass('mage')" id="class-mage">
                    <div class="class-icon">🔮</div>
                    <h3>Mage</h3>
                    <p style="font-size: 12px; color: #888;">High Mana • Spell Power</p>
                </div>
                <div class="class-card" onclick="selectClass('rogue')" id="class-rogue">
                    <div class="class-icon">🗡️</div>
                    <h3>Rogue</h3>
                    <p style="font-size: 12px; color: #888;">Fast • Critical Hits</p>
                </div>
                <div class="class-card" onclick="selectClass('knight')" id="class-knight">
                    <div class="class-icon">🛡️</div>
                    <h3>Knight</h3>
                    <p style="font-size: 12px; color: #888;">Balanced • Defender</p>
                </div>
                <div class="class-card" onclick="selectClass('ranger')" id="class-ranger">
                    <div class="class-icon">🏹</div>
                    <h3>Ranger</h3>
                    <p style="font-size: 12px; color: #888;">Ranged • Swift</p>
                </div>
            </div>
            
            <div style="margin: 20px 0;">
                <button class="btn-fantasy" onclick="startSinglePlayer()">🎮 Single Player</button>
                <button class="btn-fantasy" onclick="showMultiplayer()">🌐 Multiplayer</button>
                <button class="btn-fantasy" onclick="loadGame()">💾 Load Game</button>
            </div>
            
            <div style="margin-top: 20px; padding: 15px; background: rgba(0,0,0,0.5); border-radius: 10px; max-width: 600px;">
                <p style="font-size: 12px; color: #666;">
                    🎓 Educational Adventure • 📚 Grades K-5 • 🎨 Magical Learning<br>
                    WASD = Move • Q/E = Rotate Camera • SPACE = Interact • 1-4 = Spells
                </p>
            </div>
        </div>
        
        <div id="ui-layer" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div class="hud-panel">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                        <span style="font-size: 24px;" id="class-icon">🔮</span>
                        <div style="display: flex; flex-direction: column; gap: 3px;">
                            <div style="font-size: 14px; color: #ffd700; font-weight: bold;" id="player-name-display">Player</div>
                            <div style="font-size: 12px; color: #888;" id="player-class-display">Wizard</div>
                        </div>
                    </div>
                    
                    <div style="margin-top: 8px;">
                        <div style="display: flex; justify-content: space-between; font-size: 12px;">
                            <span>❤️ Health</span>
                            <span id="health-text">100/100</span>
                        </div>
                        <div class="stat-bar"><div class="stat-fill health-fill" id="health-fill" style="width: 100%"></div></div>
                    </div>

                    <div style="margin-top: 8px;">
                        <div style="display: flex; justify-content: space-between; font-size: 12px;">
                            <span>💧 Mana</span>
                            <span id="mana-text">50/50</span>
                        </div>
                        <div class="stat-bar"><div class="stat-fill mana-fill" id="mana-fill" style="width: 100%"></div></div>
                    </div>
                    
                    <div style="margin-top: 8px;">
                        <div style="display: flex; justify-content: space-between; font-size: 12px;">
                            <span>⭐ XP (Level <span id="level-display">1</span>)</span>
                            <span id="xp-text">0/100</span>
                        </div>
                        <div class="stat-bar"><div class="stat-fill xp-fill" id="xp-fill" style="width: 0%"></div></div>
                    </div>
                </div>
                
                <div class="player-list" id="player-list" style="display: none;">
                    <div style="color: #00ffff; font-weight: bold; margin-bottom: 10px; text-align: center;">🌐 Online Wizards</div>
                    <div id="player-entries"></div>
                </div>
                
                <div class="hud-panel">
                    <div style="font-size: 16px; font-weight: bold; color: #ffd700; margin-bottom: 10px;">🎒 Inventory</div>
                    <div id="inventory-list">
                        <div style="display: flex; align-items: center; gap: 8px; padding: 5px; background: rgba(255,255,255,0.1); border-radius: 5px; margin-bottom: 5px;">
                            <span>📚</span>
                            <span style="font-size: 12px;" id="grade-display">Grade: 1</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; padding: 5px; background: rgba(255,255,255,0.1); border-radius: 5px; margin-bottom: 5px;">
                            <span>🧪</span>
                            <span style="font-size: 12px;">Health Potions: <span id="potions-count">0</span></span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; padding: 5px; background: rgba(255,255,255,0.1); border-radius: 5px; margin-bottom: 5px;">
                            <span>📜</span>
                            <span style="font-size: 12px;">Scrolls: <span id="scrolls-count">0</span></span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; padding: 5px; background: rgba(255,255,255,0.1); border-radius: 5px;">
                            <span>💰</span>
                            <span style="font-size: 12px;">Gold: <span id="gold-count">0</span></span>
                        </div>
                    </div>
                    <div style="margin-top: 10px; font-size: 10px; color: #888;">
                        H: Heal • T: Tutor • K: Skills
                    </div>
                    <button class="btn-fantasy" onclick="exitGame()" style="width: 100%; margin-top: 10px; font-size: 12px; background: linear-gradient(135deg, #8b0000, #4a0000);">
                        🚪 Exit
                    </button>
                </div>
            </div>
            
            <div class="spell-book">
                <div class="spell-slot active" onclick="selectSpell(0)" title="Potion of Addition">
                    <span>➕</span>
                    <span class="spell-key">1</span>
                </div>
                <div class="spell-slot" onclick="selectSpell(1)" title="Scroll of Letters">
                    <span>🔤</span>
                    <span class="spell-key">2</span>
                </div>
                <div class="spell-slot locked" onclick="selectSpell(2)">
                    <span>🔒</span>
                    <span class="spell-key">3</span>
                </div>
                <div class="spell-slot locked" onclick="selectSpell(3)">
                    <span>🔒</span>
                    <span class="spell-key">4</span>
                </div>
            </div>
            
            <div id="interaction-prompt" style="position: absolute; top: 60%; left: 50%; transform: translate(-50%, -50%); 
                     background: linear-gradient(135deg, #ffd700, #ffaa00); color: #000; padding: 15px 30px; 
                     border-radius: 25px; font-weight: bold; display: none; box-shadow: 0 0 30px rgba(255,215,0,0.5);">
                Press SPACE to Interact
            </div>
        </div>
        
        <div id="potion-modal" class="modal">
            <h2 style="color: #00ccff; margin-bottom: 10px;">🧪 Potion Brewing</h2>
            <div class="cauldron"><div class="cauldron-liquid"></div></div>
            <div id="potion-question" style="font-size: 20px; color: #ffd700; margin: 20px 0;"></div>
            <div class="potion-brewing" id="ingredients-container"></div>
            <div>
                <button class="btn-fantasy" onclick="brewPotion()" style="background: linear-gradient(135deg, #00ccff, #0066cc);">Brew</button>
                <button class="btn-fantasy" onclick="closeModal('potion-modal')">Cancel</button>
            </div>
        </div>
        
        <div id="combat-modal" class="modal">
            <div style="font-size: 60px;" id="enemy-icon">👹</div>
            <h2 style="color: #ff4444;" id="enemy-name">Goblin</h2>
            <div style="background: rgba(255,0,0,0.2); border-left: 4px solid #ff4444; padding: 15px; margin: 15px 0; text-align: left;">
                <div id="combat-question" style="color: #fff; font-weight: bold;"></div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;" id="combat-answers"></div>
            <button class="btn-fantasy" onclick="askTutor()" style="background: linear-gradient(135deg, #9370db, #4a0080); margin-top: 15px;">Ask Tutor (-5 Mana)</button>
        </div>
        
        <div id="tutor-modal" class="modal">
            <div style="font-size: 40px;">🧙‍♂️</div>
            <h2 style="color: #9370db;">Professor Arcanum</h2>
            <div id="tutor-message" style="background: rgba(147, 112, 219, 0.2); padding: 20px; margin: 20px 0;"></div>
            <button class="btn-fantasy" onclick="closeModal('tutor-modal')">Close</button>
        </div>
        
        <div id="chest-modal" class="modal">
            <h2 style="color: #ffaa00;">📦 Treasure!</h2>
            <div id="chest-contents"></div>
            <button class="btn-fantasy" onclick="closeModal('chest-modal')">Take</button>
        </div>
        
        <div id="skill-tree-modal" class="modal">
            <h2 style="color: #00ff00;">Skill Tree</h2>
            <div class="skill-tree">
                <div class="skill-node" onclick="buySkill('health')" id="skill-health">
                    <div style="font-size: 30px;">❤️</div>
                    <div>+20 HP</div>
                    <div style="color: #ffd700;">1 SP</div>
                </div>
                <div class="skill-node" onclick="buySkill('mana')" id="skill-mana">
                    <div style="font-size: 30px;">💧</div>
                    <div>+15 Mana</div>
                    <div style="color: #ffd700;">1 SP</div>
                </div>
                <div class="skill-node" onclick="buySkill('power')" id="skill-power">
                    <div style="font-size: 30px;">⚡</div>
                    <div>+10 Dmg</div>
                    <div style="color: #ffd700;">2 SP</div>
                </div>
            </div>
            <div>Skill Points: <span id="skill-points">0</span></div>
            <button class="btn-fantasy" onclick="closeModal('skill-tree-modal')" style="margin-top: 20px;">Close</button>
        </div>
        
        <div id="multiplayer-modal" class="modal">
            <h2 style="color: #00ffff;">Multiplayer</h2>
            <input type="text" id="room-code" placeholder="Room Code (blank for public)" 
                   style="padding: 12px; font-size: 16px; border-radius: 25px; border: 2px solid #00ffff; 
                          background: rgba(0,0,0,0.5); color: #f4e4c1; width: 80%; text-align: center; margin: 20px 0;">
            <div>
                <button class="btn-fantasy" onclick="joinMultiplayer()" style="background: linear-gradient(135deg, #00ffff, #0066cc);">Join</button>
                <button class="btn-fantasy" onclick="closeModal('multiplayer-modal')">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        const debugLog = (() => { 
            const logs = []; 
            return (msg) => { 
                const ts = new Date().toLocaleTimeString(); 
                const fullMsg = `[${ts}] ${msg}`; 
                console.log(fullMsg); 
                logs.push(fullMsg); 
                if(logs.length > 12) logs.shift(); 
                const el = document.getElementById('debug-log'); 
                if(el) el.innerHTML = logs.map(l => l + '<br>').join(''); 
                if(document.getElementById('debug-banner')) document.getElementById('debug-banner').textContent = msg; 
            }; 
        })();
        
        debugLog('✓ index.html loaded');
        console.log('DEBUG: index.html active build 2026-02-07');

        // CURRICULUM SYSTEM
        const Curriculum = {
            grades: [
                { name: 'Kindergarten', level: 1, maxNumber: 5 },
                { name: '1st Grade', level: 2, maxNumber: 10 },
                { name: '2nd Grade', level: 3, maxNumber: 20 },
                { name: '3rd Grade', level: 4, maxNumber: 100 },
                { name: '4th Grade', level: 5, maxNumber: 1000 },
                { name: '5th Grade', level: 6, maxNumber: 10000 }
            ],
            
            generatePotionQuestion: function(grade) {
                const g = this.grades[Math.min(grade - 1, this.grades.length - 1)];
                const max = g.maxNumber;
                
                const templates = [
                    {
                        setup: `Brew a potion! You have {have} herbs, need {need} total. How many more?`,
                        generate: () => {
                            const need = Math.floor(Math.random() * (max - 2)) + 3;
                            const have = Math.floor(Math.random() * (need - 1)) + 1;
                            return { have, need, answer: need - have };
                        }
                    },
                    {
                        setup: `Mix elixir! Add {a} + {b} crystals. Total?`,
                        generate: () => {
                            const a = Math.floor(Math.random() * (max/2)) + 1;
                            const b = Math.floor(Math.random() * (max/2)) + 1;
                            return { a, b, answer: a + b };
                        }
                    }
                ];
                
                const template = templates[Math.floor(Math.random() * templates.length)];
                const data = template.generate();
                let question = template.setup;
                for (let key in data) {
                    if (key !== 'answer') question = question.replace(`{${key}}`, data[key]);
                }
                
                const answers = [data.answer];
                while (answers.length < 4) {
                    const wrong = data.answer + Math.floor(Math.random() * 10) - 5;
                    if (wrong > 0 && wrong !== data.answer && !answers.includes(wrong)) answers.push(wrong);
                }
                
                return { question, correct: 0, answers: answers.sort(() => Math.random() - 0.5) };
            },
            
            generateCombatQuestion: function(grade) {
                const g = this.grades[Math.min(grade - 1, this.grades.length - 1)];
                const max = g.maxNumber;
                
                const a = Math.floor(Math.random() * (max/2)) + 1;
                const b = Math.floor(Math.random() * (max/2)) + 1;
                const answer = a + b;
                
                const answers = [answer];
                while (answers.length < 4) {
                    const wrong = answer + Math.floor(Math.random() * 8) - 4;
                    if (wrong > 0 && wrong !== answer && !answers.includes(wrong)) answers.push(wrong);
                }
                
                return {
                    question: `Calculate: ${a} + ${b} = ?`,
                    correct: 0,
                    answers: answers.sort(() => Math.random() - 0.5)
                };
            }
        };

        // GAME STATE
        const GameState = {
            player: {
                name: '', class: 'mage', level: 1, grade: 1,
                xp: 0, xpToNext: 100,
                health: 100, maxHealth: 100,
                mana: 50, maxMana: 50,
                gold: 0, potions: 2, scrolls: 1,
                skillPoints: 0, skills: { health: 0, mana: 0, power: 0 },
                x: 0, z: 0, rotation: 0
            },
            selectedClass: null,
            selectedSpell: 0,
            inCombat: false,
            currentEnemy: null,
            currentQuestion: null,
            isPlaying: false,
            isMultiplayer: false,
            socket: null,
            otherPlayers: new Map(),
            lastMoveTime: 0
        };

        // THREE.JS VARIABLES
        let scene, camera, renderer;
        let playerContainer;
        let characterModel = null;
        let animationMixer = null;
        let walls = [], enemies = [], chests = [], crystals = [];
        let particles = [];
        let keys = {};
        let clock = new THREE.Clock();
        let cameraAngle = Math.PI;
        let gltfLoader;

        // CHARACTER MODEL PATHS - Using CDN hosted models or fallback
        const characterModels = {
            barbarian: 'https://threejs.org/examples/models/gltf/RobotExpressive/RobotExpressive.glb',
            mage: 'https://threejs.org/examples/models/gltf/RobotExpressive/RobotExpressive.glb',
            rogue: 'https://threejs.org/examples/models/gltf/RobotExpressive/RobotExpressive.glb',
            knight: 'https://threejs.org/examples/models/gltf/RobotExpressive/RobotExpressive.glb',
            ranger: 'https://threejs.org/examples/models/gltf/RobotExpressive/RobotExpressive.glb'
        };

        function init3D() {
            debugLog('▶ init3D() called');
            const canvas = document.getElementById('render-canvas');
            debugLog('Canvas: ' + (canvas ? 'found' : 'MISSING!'));
            
            scene = new THREE.Scene();
            debugLog('Scene created');
            
            // Set a dark atmospheric background
            scene.background = new THREE.Color(0x1a1a2e);
            scene.fog = new THREE.Fog(0x1a1a2e, 20, 80);
            
            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.toneMapping = THREE.LinearToneMapping;
            renderer.toneMappingExposure = 1.2;

            gltfLoader = new THREE.GLTFLoader();
            window.gltfLoader = gltfLoader;
            
            // Enhanced lighting for colorful dungeon
            const ambientLight = new THREE.AmbientLight(0x404080, 0.6);
            scene.add(ambientLight);
            
            const hemiLight = new THREE.HemisphereLight(0x87ceeb, 0x2f4f4f, 0.6);
            scene.add(hemiLight);
            
            const dirLight = new THREE.DirectionalLight(0xffd700, 0.8);
            dirLight.position.set(50, 100, 50);
            dirLight.castShadow = true;
            dirLight.shadow.mapSize.width = 2048;
            dirLight.shadow.mapSize.height = 2048;
            scene.add(dirLight);
            
            // Create player container
            playerContainer = new THREE.Group();
            scene.add(playerContainer);
            GameState.playerMesh = playerContainer;
            
            // Create torch light attached to player
            const torchLight = new THREE.PointLight(0xffaa00, 1.5, 40);
            torchLight.position.set(0, 4, 0);
            torchLight.castShadow = true;
            playerContainer.add(torchLight);
            
            // Build the world
            buildWorld();
            
            // Create character
            createCharacter();
            
            // Place objects
            placeCrystals();
            placeEnemies();
            placeChests();
            initParticles();
            
            // Set dungeon as ready
            window.dungeonReady = true;
            
            animate();
        }

        // ==========================================
        // BUILD WORLD - Creates the colorful dungeon
        // ==========================================
        function buildWorld() {
            debugLog('▶ buildWorld() - Creating colorful dungeon');
            
            const floorSize = 80;
            const tileSize = 4;
            const tilesPerSide = floorSize / tileSize;
            
            // Create colorful floor tiles
            const floorColors = [
                0x8b4513, // SaddleBrown
                0x654321, // DarkBrown
                0x4a3728, // DarkerBrown
                0x5c4033, // DarkWood
                0x6b4423  // BrownRust
            ];
            
            const floorGeometry = new THREE.BoxGeometry(tileSize, 0.5, tileSize);
            
            for (let x = -tilesPerSide/2; x < tilesPerSide/2; x++) {
                for (let z = -tilesPerSide/2; z < tilesPerSide/2; z++) {
                    const colorIndex = Math.floor(Math.random() * floorColors.length);
                    const material = new THREE.MeshStandardMaterial({ 
                        color: floorColors[colorIndex],
                        roughness: 0.8,
                        metalness: 0.2
                    });
                    
                    const tile = new THREE.Mesh(floorGeometry, material);
                    tile.position.set(x * tileSize, -0.25, z * tileSize);
                    tile.receiveShadow = true;
                    tile.userData.isDungeonTile = true;
                    scene.add(tile);
                }
            }
            
            // Create walls with different colors for different areas
            const wallHeight = 6;
            const wallThickness = 1;
            
            // Define wall sections with colors
            const wallSections = [
                // Outer walls
                { x: -floorSize/2, z: 0, w: wallThickness, d: floorSize, color: 0x4a4a6a }, // Left
                { x: floorSize/2, z: 0, w: wallThickness, d: floorSize, color: 0x4a4a6a },  // Right
                { x: 0, z: -floorSize/2, w: floorSize, d: wallThickness, color: 0x5a5a7a }, // Back
                { x: 0, z: floorSize/2, w: floorSize, d: wallThickness, color: 0x5a5a7a },  // Front
                
                // Inner walls - create rooms
                { x: -20, z: 0, w: wallThickness, d: 30, color: 0x6b4423 },
                { x: 20, z: 0, w: wallThickness, d: 30, color: 0x6b4423 },
                { x: 0, z: -20, w: 30, d: wallThickness, color: 0x5c4033 },
                { x: 0, z: 20, w: 30, d: wallThickness, color: 0x5c4033 },
                
                // Decorative pillars
                { x: -30, z: -30, w: 3, d: 3, color: 0x8b4513 },
                { x: 30, z: -30, w: 3, d: 3, color: 0x8b4513 },
                { x: -30, z: 30, w: 3, d: 3, color: 0x8b4513 },
                { x: 30, z: 30, w: 3, d: 3, color: 0x8b4513 }
            ];
            
            wallSections.forEach(section => {
                const geometry = new THREE.BoxGeometry(section.w, wallHeight, section.d);
                const material = new THREE.MeshStandardMaterial({ 
                    color: section.color,
                    roughness: 0.9,
                    metalness: 0.1
                });
                const wall = new THREE.Mesh(geometry, material);
                wall.position.set(section.x, wallHeight/2, section.z);
                wall.castShadow = true;
                wall.receiveShadow = true;
                wall.userData.isDungeonTile = true;
                scene.add(wall);
                
                // Add to collision walls
                walls.push({ 
                    x: section.x, 
                    z: section.z, 
                    size: Math.max(section.w, section.d),
                    halfW: section.w/2,
                    halfD: section.d/2
                });
            });
            
            // Add decorative elements - torches on walls
            const torchPositions = [
                { x: -38, z: 0, rot: 0 },
                { x: 38, z: 0, rot: Math.PI },
                { x: 0, z: -38, rot: Math.PI/2 },
                { x: 0, z: 38, rot: -Math.PI/2 }
            ];
            
            torchPositions.forEach(pos => {
                const torch = createTorch();
                torch.position.set(pos.x, 4, pos.z);
                torch.rotation.y = pos.rot;
                scene.add(torch);
            });
            
            debugLog('✓ Dungeon built with ' + walls.length + ' wall sections');
        }

        function createTorch() {
            const group = new THREE.Group();
            
            // Torch handle
            const handleGeo = new THREE.CylinderGeometry(0.1, 0.1, 1.5);
            const handleMat = new THREE.MeshStandardMaterial({ color: 0x4a3728 });
            const handle = new THREE.Mesh(handleGeo, handleMat);
            group.add(handle);
            
            // Flame light
            const light = new THREE.PointLight(0xff6600, 1, 15);
            light.position.y = 0.5;
            group.add(light);
            
            // Flame particle (simple sphere)
            const flameGeo = new THREE.SphereGeometry(0.2, 8, 8);
            const flameMat = new THREE.MeshBasicMaterial({ color: 0xff6600 });
            const flame = new THREE.Mesh(flameGeo, flameMat);
            flame.position.y = 0.8;
            group.add(flame);
            
            return group;
        }

        function createCharacter() {
            const className = GameState.selectedClass || 'mage';
            const modelPath = characterModels[className];
            
            console.log('Loading model:', modelPath);
            
            gltfLoader.load(
                modelPath,
                (gltf) => {
                    console.log('Model loaded successfully');
                    const model = gltf.scene;

                    // Ensure meshes are visible and well-lit
                    model.traverse((child) => {
                        if (child.isMesh) {
                            child.castShadow = true;
                            child.receiveShadow = true;
                            if (child.material) {
                                const materials = Array.isArray(child.material) ? child.material : [child.material];
                                materials.forEach((mat) => {
                                    mat.transparent = false;
                                    mat.opacity = 1;
                                    mat.side = THREE.DoubleSide;
                                    if (mat.emissive) {
                                        mat.emissiveIntensity = Math.max(mat.emissiveIntensity || 0, 0.25);
                                    }
                                    mat.needsUpdate = true;
                                });
                            }
                        }
                    });
                    
                    // Center and scale the model
                    const box = new THREE.Box3().setFromObject(model);
                    const center = box.getCenter(new THREE.Vector3());
                    const size = box.getSize(new THREE.Vector3());
                    
                    const pivot = new THREE.Group();
                    pivot.add(model);
                    
                    model.position.x = -center.x;
                    model.position.z = -center.z;
                    model.position.y = -box.min.y;
                    model.rotation.y = Math.PI;
                    
                    const scale = 2.0 / size.y;
                    pivot.scale.set(scale, scale, scale);
                    
                    playerContainer.add(pivot);
                    playerContainer.position.set(0, 0, 0);
                    characterModel = pivot;
                    GameState.characterModel = model;
                    
                    // Setup animations
                    if (gltf.animations && gltf.animations.length > 0) {
                        animationMixer = new THREE.AnimationMixer(model);
                        gltf.animations.forEach((clip, index) => {
                            const action = animationMixer.clipAction(clip);
                            GameState.animationActions = GameState.animationActions || {};
                            GameState.animationActions[clip.name] = action;
                            
                            if (index === 0) {
                                action.play();
                            }
                        });
                    }
                    
                    console.log('✓ Character attached and positioned');
                },
                undefined,
                (error) => {
                    console.error('Model load failed, using fallback:', error);
                    createFallbackCharacter();
                }
            );
        }

        function createFallbackCharacter() {
            // Simple colored capsule character
            const group = new THREE.Group();
            
            const geometry = new THREE.CapsuleGeometry(0.5, 2, 4, 8);
            const classColors = {
                barbarian: 0x8b0000,
                mage: 0x4a0080,
                rogue: 0x006400,
                knight: 0x4682b4,
                ranger: 0x228b22
            };
            const material = new THREE.MeshStandardMaterial({ 
                color: classColors[GameState.selectedClass] || 0x808080,
                emissive: classColors[GameState.selectedClass] || 0x808080,
                emissiveIntensity: 0.2
            });
            const mesh = new THREE.Mesh(geometry, material);
            mesh.position.y = 1.5;
            mesh.castShadow = true;
            
            group.add(mesh);
            playerContainer.add(group);
            characterModel = group;
            
            console.log('✓ Fallback character created');
        }

        function placeCrystals() {
            for (let i = 0; i < 6; i++) {
                const crystal = new THREE.Mesh(
                    new THREE.OctahedronGeometry(0.6),
                    new THREE.MeshStandardMaterial({ 
                        color: 0x00ffff, 
                        emissive: 0x00ffff,
                        emissiveIntensity: 0.8,
                        transparent: true,
                        opacity: 0.9
                    })
                );
                const x = (Math.random() - 0.5) * 60;
                const z = (Math.random() - 0.5) * 60;
                crystal.position.set(x, 1.5, z);
                crystal.userData = { type: 'crystal', id: i, collected: false };
                crystal.castShadow = true;
                scene.add(crystal);
                crystals.push(crystal);
            }
        }

        function placeEnemies() {
            const enemyColors = [0xff0000, 0xff6600, 0x990000];
            const enemyNames = ['Goblin', 'Orc', 'Troll'];
            
            for (let i = 0; i < 5; i++) {
                const enemy = new THREE.Mesh(
                    new THREE.ConeGeometry(0.6, 2, 8),
                    new THREE.MeshStandardMaterial({ 
                        color: enemyColors[i % 3],
                        emissive: enemyColors[i % 3],
                        emissiveIntensity: 0.3
                    })
                );
                const x = (Math.random() - 0.5) * 50;
                const z = (Math.random() - 0.5) * 50;
                enemy.position.set(x, 1, z);
                enemy.userData = { 
                    type: 'enemy', 
                    name: enemyNames[i % 3],
                    hp: 30,
                    active: true 
                };
                enemy.castShadow = true;
                scene.add(enemy);
                enemies.push(enemy);
            }
        }

        function placeChests() {
            for (let i = 0; i < 4; i++) {
                const chest = new THREE.Mesh(
                    new THREE.BoxGeometry(1.5, 1, 1),
                    new THREE.MeshStandardMaterial({ 
                        color: 0xffaa00,
                        emissive: 0xffaa00,
                        emissiveIntensity: 0.2,
                        metalness: 0.6,
                        roughness: 0.4
                    })
                );
                const x = (Math.random() - 0.5) * 60;
                const z = (Math.random() - 0.5) * 60;
                chest.position.set(x, 0.5, z);
                chest.userData = { type: 'chest', opened: false };
                chest.castShadow = true;
                scene.add(chest);
                chests.push(chest);
            }
        }

        function initParticles() {
            const geometry = new THREE.BufferGeometry();
            const count = 200;
            const positions = new Float32Array(count * 3);
            const colors = new Float32Array(count * 3);
            
            for (let i = 0; i < count * 3; i += 3) {
                positions[i] = (Math.random() - 0.5) * 80;
                positions[i+1] = Math.random() * 20;
                positions[i+2] = (Math.random() - 0.5) * 80;
                
                // Golden particles
                colors[i] = 1.0;
                colors[i+1] = 0.8;
                colors[i+2] = 0.2;
            }
            
            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
            
            const material = new THREE.PointsMaterial({
                size: 0.3,
                transparent: true,
                opacity: 0.8,
                vertexColors: true,
                blending: THREE.AdditiveBlending
            });
            
            const particleSystem = new THREE.Points(geometry, material);
            scene.add(particleSystem);
            particles.push(particleSystem);
        }

        function animate() {
            requestAnimationFrame(animate);
            
            const delta = clock.getDelta();
            
            // Animate crystals
            crystals.forEach((crystal, i) => {
                if (!crystal.userData.collected) {
                    crystal.rotation.y += delta * 2;
                    crystal.position.y = 1.5 + Math.sin(clock.elapsedTime * 2 + i) * 0.3;
                }
            });
            
            // Animate particles
            particles.forEach(p => {
                const positions = p.geometry.attributes.position.array;
                for (let i = 1; i < positions.length; i += 3) {
                    positions[i] += Math.sin(clock.elapsedTime + positions[i-1]) * 0.02;
                }
                p.geometry.attributes.position.needsUpdate = true;
            });
            
            // Check if player is moving
            const isMoving = keys['w'] || keys['a'] || keys['s'] || keys['d'] || 
                           keys['arrowup'] || keys['arrowleft'] || keys['arrowdown'] || keys['arrowright'];
            
            // Update character animation
            if (animationMixer) {
                animationMixer.update(delta);
            }
            
            if (GameState.isPlaying && !GameState.inCombat) {
                updateMovement();
            }
            
            updateCamera();
            checkInteractions();
            
            renderer.render(scene, camera);
        }

        function updateMovement() {
            if (!window.dungeonReady) return;
            
            const speed = 0.15;
            let dx = 0, dz = 0;
            
            // Camera rotation
            if (keys['q']) cameraAngle += 0.04;
            if (keys['e']) cameraAngle -= 0.04;
            
            // Movement relative to camera
            if (keys['w'] || keys['arrowup']) {
                dx += Math.sin(cameraAngle) * speed;
                dz += Math.cos(cameraAngle) * speed;
            }
            if (keys['s'] || keys['arrowdown']) {
                dx -= Math.sin(cameraAngle) * speed * 0.6;
                dz -= Math.cos(cameraAngle) * speed * 0.6;
            }
            if (keys['a'] || keys['arrowleft']) {
                dx += Math.sin(cameraAngle + Math.PI/2) * speed;
                dz += Math.cos(cameraAngle + Math.PI/2) * speed;
            }
            if (keys['d'] || keys['arrowright']) {
                dx += Math.sin(cameraAngle - Math.PI/2) * speed;
                dz += Math.cos(cameraAngle - Math.PI/2) * speed;
            }
            
            if (dx !== 0 || dz !== 0) {
                const newX = GameState.player.x + dx;
                const newZ = GameState.player.z + dz;
                
                if (!checkCollision(newX, newZ)) {
                    GameState.player.x = newX;
                    GameState.player.z = newZ;
                    playerContainer.position.set(newX, 0, newZ);
                    
                    // Rotate character to face movement
                    if (characterModel) {
                        const targetRotation = Math.atan2(dx, dz);
                        characterModel.rotation.y = targetRotation + Math.PI;
                    }
                    
                    // Multiplayer sync
                    if (GameState.isMultiplayer && GameState.socket) {
                        const now = Date.now();
                        if (now - GameState.lastMoveTime > 50) {
                            GameState.socket.emit('move', { x: newX, z: newZ });
                            GameState.lastMoveTime = now;
                        }
                    }
                }
            }
        }

        function checkCollision(x, z) {
            const buffer = 1.2;
            
            // Check wall colliders
            for (let wall of walls) {
                if (Math.abs(x - wall.x) < wall.halfW + buffer && 
                    Math.abs(z - wall.z) < wall.halfD + buffer) {
                    return true;
                }
            }
            return false;
        }

        function updateCamera() {
            const dist = 10;
            const height = 8;
            
            const targetX = GameState.player.x - Math.sin(cameraAngle) * dist;
            const targetZ = GameState.player.z - Math.cos(cameraAngle) * dist;
            
            camera.position.x += (targetX - camera.position.x) * 0.1;
            camera.position.z += (targetZ - camera.position.z) * 0.1;
            camera.position.y = height;
            
            camera.lookAt(GameState.player.x, 2, GameState.player.z);
        }

        let nearestInteractable = null;
        
        function checkInteractions() {
            nearestInteractable = null;
            let nearestDist = 3;
            
            // Check crystals
            crystals.forEach(crystal => {
                if (crystal.userData.collected) return;
                const dist = Math.hypot(crystal.position.x - GameState.player.x, crystal.position.z - GameState.player.z);
                if (dist < nearestDist) {
                    nearestDist = dist;
                    nearestInteractable = { type: 'crystal', object: crystal };
                }
            });
            
            // Check enemies
            enemies.forEach(enemy => {
                if (!enemy.userData.active) return;
                const dist = Math.hypot(enemy.position.x - GameState.player.x, enemy.position.z - GameState.player.z);
                if (dist < nearestDist) {
                    nearestDist = dist;
                    nearestInteractable = { type: 'enemy', object: enemy };
                }
            });
            
            // Check chests
            chests.forEach(chest => {
                if (chest.userData.opened) return;
                const dist = Math.hypot(chest.position.x - GameState.player.x, chest.position.z - GameState.player.z);
                if (dist < nearestDist) {
                    nearestDist = dist;
                    nearestInteractable = { type: 'chest', object: chest };
                }
            });
            
            const prompt = document.getElementById('interaction-prompt');
            if (nearestInteractable) {
                prompt.style.display = 'block';
                prompt.textContent = `Press SPACE to ${nearestInteractable.type === 'enemy' ? 'Fight' : nearestInteractable.type === 'crystal' ? 'Collect' : 'Open'}`;
            } else {
                prompt.style.display = 'none';
            }
        }

        // INPUT HANDLING
        document.addEventListener('keydown', (e) => {
            if (!e.key) return;
            keys[e.key.toLowerCase()] = true;
            if (!GameState.isPlaying) return;
            
            if (e.code === 'Space' && nearestInteractable) {
                handleInteraction();
            }
            if (e.key >= '1' && e.key <= '4') selectSpell(parseInt(e.key) - 1);
            if (e.key.toLowerCase() === 'h') useHealthPotion();
            if (e.key.toLowerCase() === 't') openTutor();
            if (e.key.toLowerCase() === 'k') openSkillTree();
        });
        
        document.addEventListener('keyup', (e) => {
            if (!e.key) return;
            keys[e.key.toLowerCase()] = false;
        });

        function handleInteraction() {
            if (!nearestInteractable) return;
            
            if (nearestInteractable.type === 'crystal') {
                collectCrystal(nearestInteractable.object);
            } else if (nearestInteractable.type === 'enemy') {
                startCombat(nearestInteractable.object);
            } else if (nearestInteractable.type === 'chest') {
                openChest(nearestInteractable.object);
            }
        }

        function startCombat(enemy) {
            GameState.inCombat = true;
            GameState.currentEnemy = enemy;
            
            const q = Curriculum.generateCombatQuestion(GameState.player.grade);
            GameState.currentQuestion = q;
            
            document.getElementById('enemy-icon').textContent = '👹';
            document.getElementById('enemy-name').textContent = enemy.userData.name;
            document.getElementById('combat-question').textContent = q.question;
            
            const container = document.getElementById('combat-answers');
            container.innerHTML = '';
            q.answers.forEach((ans, idx) => {
                const btn = document.createElement('button');
                btn.className = 'btn-fantasy';
                btn.textContent = ans;
                btn.onclick = () => {
                    if (idx === q.correct) {
                        enemy.userData.hp -= 25;
                        if (enemy.userData.hp <= 0) {
                            enemy.userData.active = false;
                            enemy.visible = false;
                            addXP(50);
                        } else {
                            addXP(20);
                        }
                    } else {
                        GameState.player.health -= 10;
                        updateHUD();
                    }
                    closeModal('combat-modal');
                    GameState.inCombat = false;
                };
                container.appendChild(btn);
            });
            
            document.getElementById('combat-modal').style.display = 'block';
        }

        function collectCrystal(crystal) {
            crystal.userData.collected = true;
            crystal.visible = false;
            addXP(100);
            showFloatingText('+100 XP', '#00ffff');
        }

        function openChest(chest) {
            chest.userData.opened = true;
            chest.visible = false;
            GameState.player.gold += 20;
            document.getElementById('chest-contents').innerHTML = '<div style="font-size: 40px;">💰</div><div>+20 Gold</div>';
            document.getElementById('chest-modal').style.display = 'block';
            updateHUD();
        }

        function addXP(amount) {
            GameState.player.xp += amount;
            if (GameState.player.xp >= GameState.player.xpToNext) {
                GameState.player.level++;
                GameState.player.xp -= GameState.player.xpToNext;
                GameState.player.xpToNext = Math.floor(GameState.player.xpToNext * 1.5);
                GameState.player.maxHealth += 10;
                GameState.player.health = GameState.player.maxHealth;
                GameState.player.skillPoints++;
                showFloatingText('LEVEL UP!', '#ffd700');
                updateHUD();
            }
            updateHUD();
        }

        function openPotionBrewing() {
            const q = Curriculum.generatePotionQuestion(GameState.player.grade);
            GameState.currentQuestion = q;
            document.getElementById('potion-question').textContent = q.question;
            
            const container = document.getElementById('ingredients-container');
            container.innerHTML = '';
            q.answers.forEach((ans, idx) => {
                const div = document.createElement('div');
                div.className = 'ingredient';
                div.innerHTML = `<div style="font-size: 24px;">${idx === 0 ? '✨' : '🌿'}</div><div>${ans}</div>`;
                div.onclick = () => {
                    document.querySelectorAll('.ingredient').forEach(el => el.classList.remove('selected'));
                    div.classList.add('selected');
                    GameState.selectedIngredient = idx;
                };
                container.appendChild(div);
            });
            
            document.getElementById('potion-modal').style.display = 'block';
        }

        function brewPotion() {
            if (GameState.selectedIngredient === GameState.currentQuestion.correct) {
                GameState.player.potions++;
                showFloatingText('Potion Created!', '#00ccff');
            } else {
                GameState.player.mana -= 5;
            }
            closeModal('potion-modal');
            updateHUD();
        }

        function askTutor() {
            if (GameState.player.mana >= 5) {
                GameState.player.mana -= 5;
                openTutor();
                updateHUD();
            }
        }

        function openTutor() {
            document.getElementById('tutor-message').textContent = 'Remember: Take your time counting. If you have 3 and need 7, you need 4 more!';
            document.getElementById('tutor-modal').style.display = 'block';
        }

        function openSkillTree() {
            document.getElementById('skill-points').textContent = GameState.player.skillPoints;
            document.getElementById('skill-tree-modal').style.display = 'block';
        }

        function buySkill(skill) {
            if (GameState.player.skillPoints <= 0) return;
            const costs = { health: 1, mana: 1, power: 2 };
            if (GameState.player.skillPoints < costs[skill]) return;
            
            GameState.player.skillPoints -= costs[skill];
            if (skill === 'health') {
                GameState.player.maxHealth += 20;
                GameState.player.health = GameState.player.maxHealth;
            } else if (skill === 'mana') {
                GameState.player.maxMana += 15;
                GameState.player.mana = GameState.player.maxMana;
            }
            document.getElementById(`skill-${skill}`).classList.add('purchased');
            updateHUD();
            openSkillTree();
        }

        function selectSpell(index) {
            GameState.selectedSpell = index;
            document.querySelectorAll('.spell-slot').forEach((slot, i) => {
                slot.classList.toggle('active', i === index);
            });
            if (index === 0) openPotionBrewing();
        }

        function useHealthPotion() {
            if (GameState.player.potions > 0 && GameState.player.health < GameState.player.maxHealth) {
                GameState.player.potions--;
                GameState.player.health = Math.min(GameState.player.maxHealth, GameState.player.health + 30);
                updateHUD();
                showFloatingText('+30 HP', '#00ff00');
            }
        }

        function showFloatingText(text, color) {
            const el = document.createElement('div');
            el.className = 'floating-text';
            el.textContent = text;
            el.style.color = color;
            el.style.left = '50%';
            el.style.top = '40%';
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 1500);
        }

        function updateHUD() {
            const healthText = document.getElementById('health-text');
            if (healthText) healthText.textContent = `${GameState.player.health}/${GameState.player.maxHealth}`;
            
            const healthFill = document.getElementById('health-fill');
            if (healthFill) healthFill.style.width = (GameState.player.health / GameState.player.maxHealth * 100) + '%';
            
            const manaText = document.getElementById('mana-text');
            if (manaText) manaText.textContent = `${GameState.player.mana}/${GameState.player.maxMana}`;
            
            const manaFill = document.getElementById('mana-fill');
            if (manaFill) manaFill.style.width = (GameState.player.mana / GameState.player.maxMana * 100) + '%';
            
            const xpText = document.getElementById('xp-text');
            if (xpText) xpText.textContent = `${GameState.player.xp}/${GameState.player.xpToNext}`;
            
            const xpFill = document.getElementById('xp-fill');
            if (xpFill) xpFill.style.width = (GameState.player.xp / GameState.player.xpToNext * 100) + '%';
            
            const levelDisplay = document.getElementById('level-display');
            if (levelDisplay) levelDisplay.textContent = GameState.player.level;
            
            const potionsCount = document.getElementById('potions-count');
            if (potionsCount) potionsCount.textContent = GameState.player.potions;
            
            const scrollsCount = document.getElementById('scrolls-count');
            if (scrollsCount) scrollsCount.textContent = GameState.player.scrolls;
            
            const goldCount = document.getElementById('gold-count');
            if (goldCount) goldCount.textContent = GameState.player.gold;
            
            const gradeDisplay = document.getElementById('grade-display');
            if (gradeDisplay && Curriculum && Curriculum.grades) {
                const gradeInfo = Curriculum.grades[GameState.player.grade - 1];
                gradeDisplay.textContent = `Grade: ${gradeInfo.name}`;
            }
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        function saveGame() {
            localStorage.setItem('loreAndLegendsSave', JSON.stringify({
                player: GameState.player,
                timestamp: Date.now()
            }));
            showFloatingText('Game Saved!', '#00ff00');
        }

        function loadGame() {
            const data = localStorage.getItem('loreAndLegendsSave');
            if (data) {
                const save = JSON.parse(data);
                Object.assign(GameState.player, save.player);
                startSinglePlayer();
                updateHUD();
                showFloatingText('Game Loaded!', '#00ff00');
            } else {
                alert('No save found!');
            }
        }

        function showMultiplayer() {
            if (!document.getElementById('player-name').value.trim() || !GameState.selectedClass) {
                alert('Enter name and select class!');
                return;
            }
            document.getElementById('multiplayer-modal').style.display = 'block';
        }

        function joinMultiplayer() {
            const name = document.getElementById('player-name').value.trim();
            const room = document.getElementById('room-code').value.trim() || 'public';
            if (!name) {
                alert('⚠️ Please enter your name!');
                return;
            }
            if (!GameState.selectedClass) {
                alert('⚠️ Please select a character class!');
                return;
            }
            document.getElementById('multiplayer-modal').style.display = 'none';
            startGame(true);
            
            // Mock multiplayer for demo
            GameState.isMultiplayer = true;
            document.getElementById('player-list').style.display = 'block';
            document.getElementById('player-entries').innerHTML = `
                <div class="player-entry">
                    <span style="color: #00ff00;">●</span>
                    <span>${name} (You)</span>
                </div>
            `;
        }

        function selectClass(className) {
            GameState.selectedClass = className;
            document.querySelectorAll('.class-card').forEach(c => c.classList.remove('selected'));
            document.getElementById(`class-${className}`).classList.add('selected');
            
            // Set class stats
            const classStats = {
                barbarian: { hp: 150, mana: 30 },
                mage: { hp: 70, mana: 80 },
                rogue: { hp: 80, mana: 60 },
                knight: { hp: 120, mana: 40 },
                ranger: { hp: 90, mana: 55 }
            };
            
            const stats = classStats[className] || { hp: 100, mana: 50 };
            GameState.player.maxHealth = stats.hp;
            GameState.player.health = stats.hp;
            GameState.player.maxMana = stats.mana;
            GameState.player.mana = stats.mana;
        }

        function startGame(isMultiplayer = false) {
            debugLog('▶ startGame() START');
            const name = document.getElementById('player-name').value.trim();
            if (!name || !GameState.selectedClass) {
                alert('Enter name and select class!');
                return;
            }
            
            GameState.player.name = name;
            GameState.player.class = GameState.selectedClass;
            GameState.isMultiplayer = isMultiplayer;
            
            document.getElementById('start-screen').style.display = 'none';
            document.getElementById('ui-layer').style.display = 'flex';
            document.getElementById('player-list').style.display = isMultiplayer ? 'block' : 'none';
            document.getElementById('player-name-display').textContent = GameState.player.name;
            
            const classIcons = {
                barbarian: '⚔️',
                mage: '🔮',
                rogue: '🗡️',
                knight: '🛡️',
                ranger: '🏹'
            };
            document.getElementById('class-icon').textContent = classIcons[GameState.selectedClass] || '🎮';
            
            init3D();
            GameState.isPlaying = true;
            updateHUD();
            setInterval(saveGame, 60000);
        }

        function startSinglePlayer() {
            startGame(false);
        }

        function exitGame() {
            if (confirm('Exit? Progress saved.')) {
                saveGame();
                location.reload();
            }
        }

        window.addEventListener('resize', () => {
            if (camera && renderer) {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            }
        });
    </script>
</body>
</html>
